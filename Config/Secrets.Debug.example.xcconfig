// STAGING — copy to Secrets.Debug.xcconfig and fill in. That file is gitignored.
//   cp Config/Secrets.Debug.example.xcconfig Config/Secrets.Debug.xcconfig
//
// Read by Debug builds: Xcode and the simulator. This is the database that
// carries the seed cooks, and where migrations are tried before production
// sees them.
//
//
// Use the ANON / PUBLISHABLE key only. It is designed to ship inside a client
// and is protected by RLS. The service_role key bypasses RLS entirely and must
// never appear in the app, in this file, or in the repo.
//
// xcconfig treats "//" as the start of a comment, so the URL scheme has to be
// split with $() or everything after "https:" is silently dropped.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-key
