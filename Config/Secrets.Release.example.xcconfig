// PRODUCTION — copy to Secrets.Release.xcconfig and fill in. That file is gitignored.
//   cp Config/Secrets.Release.example.xcconfig Config/Secrets.Release.xcconfig
//
// Read by archives, and therefore by TestFlight and the App Store. Must NOT be
// the same project as staging: testers would otherwise share a database with
// the seed cooks and with every migration tried out against it.
//
//
// Use the ANON / PUBLISHABLE key only. It is designed to ship inside a client
// and is protected by RLS. The service_role key bypasses RLS entirely and must
// never appear in the app, in this file, or in the repo.
//
// xcconfig treats "//" as the start of a comment, so the URL scheme has to be
// split with $() or everything after "https:" is silently dropped.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-key
